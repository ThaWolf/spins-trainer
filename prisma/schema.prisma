generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  BTN
  SB
  BB
}

enum Level {
  BASIC
  PRO
  ELITE
}

enum VillainAction {
  NONE
  OR
  LIMP
}

enum Action {
  NONE
  CALL
  BET
  ALL_IN
  FOLD
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  email            String            @unique
  passwordHash     String
  createdAt        DateTime          @default(now())
  trainingSessions TrainingSession[]
}

model PreflopTable {
  id              Int               @id @default(autoincrement())
  heroPosition    Position
  villainPosition Position
  level           Level
  variation       String
  rangeData       Json
  scenarios       Scenario[]
  TrainingSession TrainingSession[]
}

model TrainingSession {
  id            Int      @id @default(autoincrement())
  userId        Int
  tableId       Int
  hand          String
  actionTaken   Action
  correctAction Action
  result        Boolean
  createdAt     DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id])
  table PreflopTable @relation(fields: [tableId], references: [id])
}

model Scenario {
  id             Int           @id @default(autoincrement())
  tableId        Int
  scenarioType   String
  villainAction  VillainAction
  expectedAction Action
  createdAt      DateTime      @default(now())

  table PreflopTable @relation(fields: [tableId], references: [id])
}
